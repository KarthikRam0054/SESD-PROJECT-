# ==========================================
# REALTOR - Environment Configuration Guide
# ==========================================

# Backend Configuration (backend/.env)
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/realtor_db
JWT_SECRET=realtor_super_secret_jwt_key_2026_modern_marketplace
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional: Cloudinary Cloud Image Storage
# If left blank, uploads are automatically saved locally to backend/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend Configuration (frontend/.env)
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

